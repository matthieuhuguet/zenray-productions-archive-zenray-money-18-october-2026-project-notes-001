      };
      if (map[kind]) {
        const a = new Audio(map[kind]);
        a.volume = 0.65;
        a.play().catch(() => {});
      }
      if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      const now = audioCtx.currentTime;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      if (kind === 'hover') {
        osc.frequency.setValueAtTime(2200, now);
        osc.frequency.exponentialRampToValueAtTime(3300, now + 0.06);
        gain.gain.setValueAtTime(0.04, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.06);
        osc.start(now);
        osc.stop(now + 0.06);
      }
    } catch (e) {}
  }

  function pickDesign(letter) {
    chosen = letter;
    playHexSound('click');
    ['A', 'B', 'C'].forEach((k) => {
      document.getElementById('sec' + k).classList.toggle('selected', k === letter);
      document.getElementById('btn' + k).classList.toggle('active', k === letter);
    });
  }

  function setV(prop, val, id) {
    document.documentElement.style.setProperty(prop, val);
    document.getElementById(id).textContent = val;
  }

  function updateUrssaf(val) {
    document.documentElement.style.setProperty('--urssaf-rate', val);
    document.getElementById('vUrssaf').textContent = val + '%';
    document.getElementById('lblUrssaf').textContent = val + '%';
    recalcInvoice();
  }

  function recalcInvoice() {
    const brut = parseFloat(document.getElementById('invBrut').value) || 0;
    const rate = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--urssaf-rate')) || 21.2;
    const net = brut * (1 - rate / 100);
    document.getElementById('invNetOut').textContent = '+' + net.toFixed(2).replace('.', ',') + ' € NET';
  }

