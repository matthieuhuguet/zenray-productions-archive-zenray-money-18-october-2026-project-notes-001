  function copyChoice() {
    const cs = getComputedStyle(document.documentElement);
    const txt = [
      'Design ZenRay Money v2 choisi : ' + chosen,
      'font=Beaufort for LoL + AnthropicSerif Medium 500',
      'dial=' + cs.getPropertyValue('--hex-dial-size').trim(),
